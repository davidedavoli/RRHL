import Xhl.Language.Syntax

/-!
# The plain concrete memory

`plainMemType`: the heap `CoreMem` (`Syntax.lean`) under the σ-algebra generated by its
slot projections `m ↦ m.get t x`, packaged as a `MemType`. `PMem := plainMemType String`
(`Examples/DPSGD/Shared/Paper.lean`) is the memory all case studies run on. No
countable-generation property is required of this σ-algebra.
-/

open MeasureTheory

namespace Continuous

namespace CoreMem

variable {ident : Type}

/-- The σ-algebra on `CoreMem ident` making every projection `m ↦ m.get t x` measurable:
    the comap of the `Ty × ident`-indexed product of the slot σ-algebras. -/
@[implicit_reducible] def slots (ident : Type) : MeasurableSpace (CoreMem ident) :=
  ⨆ p : Ty × ident, MeasurableSpace.comap
    (fun m : CoreMem ident => m.get p.1 p.2) (Ty.measurableSpace p.1)

/-- Every slot is readable measurably. -/
lemma measurable_get (t : Ty) (x : ident) :
    @Measurable (CoreMem ident) t.interp (slots ident) _ (fun m => m.get t x) := by
  rw [measurable_iff_comap_le]
  exact le_iSup (f := fun p : Ty × ident => MeasurableSpace.comap
    (fun m : CoreMem ident => m.get p.1 p.2) (Ty.measurableSpace p.1)) (t, x)

variable [DecidableEq ident]

/-- Reading one slot after writing another is measurable in `(state, written value)`. -/
lemma measurable_set_get {t u : Ty} (x y : ident)
    (hu : @Measurable (CoreMem ident) u.interp (slots ident) _ (fun m => m.get u y)) :
    @Measurable (CoreMem ident × t.interp) u.interp
      (@Prod.instMeasurableSpace _ _ (slots ident) (Ty.measurableSpace t)) _
      (fun mv => (mv.1.set t x mv.2).get u y) := by
  by_cases h : t = u
  · subst h
    by_cases hxy : x = y
    · subst hxy
      have e : (fun mv : CoreMem ident × t.interp => (mv.1.set t x mv.2).get t x)
          = fun mv => mv.2 := funext fun mv => mv.1.get_set_eq t x mv.2
      rw [e]; exact measurable_snd
    · have e : (fun mv : CoreMem ident × t.interp => (mv.1.set t x mv.2).get t y)
          = fun mv => mv.1.get t y :=
        funext fun mv => mv.1.get_set_ne t t x y mv.2 (Or.inr hxy)
      rw [e]; exact hu.comp measurable_fst
  · have e : (fun mv : CoreMem ident × t.interp => (mv.1.set t x mv.2).get u y)
        = fun mv => mv.1.get u y :=
      funext fun mv => mv.1.get_set_ne t u x y mv.2 (Or.inl h)
    rw [e]; exact hu.comp measurable_fst

end CoreMem

/-- **The plain concrete memory**: the `CoreMem` heap with the plain `get`/`set`, under
    the σ-algebra `CoreMem.slots` generated by its projections. -/
noncomputable def plainMemType (ident : Type) [DecidableEq ident] : MemType ident where
  heap     := CoreMem ident
  heapMeas := CoreMem.slots ident
  get m t x   := m.get t x
  set m t x v := m.set t x v
  get_set_eq t m x v        := m.get_set_eq t x v
  get_set_ne t u m x y v h := m.get_set_ne t u x y v h
  set_get_eq t m x := m.set_get_eq t x
  ext m m' h := by cases m; cases m'; congr 1; funext t z; exact h t z
  get_measurable t x := CoreMem.measurable_get t x
  set_measurable x := by
    rename_i t
    rw [measurable_iff_comap_le, CoreMem.slots, MeasurableSpace.comap_iSup]
    refine iSup_le fun p => ?_
    rw [MeasurableSpace.comap_comp, ← measurable_iff_comap_le]
    exact CoreMem.measurable_set_get (t := t) x p.2 (CoreMem.measurable_get p.1 p.2)

end Continuous
